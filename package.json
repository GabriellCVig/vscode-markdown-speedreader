{
  "name": "markdownspeedreader",
  "displayName": "Markdown Speed Reader",
  "description": "A VSCode extension for speed reading markdown and text files with configurable reading speeds and controls.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/markdownspeedreader.git"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownspeedreader.speedreadFile",
        "title": "Speed Read Current File",
        "category": "Speed Reader"
      },
      {
        "command": "markdownspeedreader.speedreadSelection",
        "title": "Speed Read Selection",
        "category": "Speed Reader"
      },
      {
        "command": "markdownspeedreader.speedreadFromFile",
        "title": "Speed Read File...",
        "category": "Speed Reader"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "markdownspeedreader.speedreadFile",
          "when": "editorTextFocus",
          "group": "speedreader"
        },
        {
          "command": "markdownspeedreader.speedreadSelection",
          "when": "editorHasSelection",
          "group": "speedreader"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownspeedreader.speedreadFromFile",
          "when": "resourceExtname == .md || resourceExtname == .txt || resourceExtname == .markdown",
          "group": "speedreader"
        }
      ]
    },
    "configuration": {
      "title": "Speed Reader",
      "properties": {
        "speedreader.defaultWPM": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "maximum": 1000,
          "description": "Default words per minute for speed reading"
        },
        "speedreader.pauseOnPunctuation": {
          "type": "boolean",
          "default": true,
          "description": "Pause briefly after punctuation marks"
        },
        "speedreader.fontSize": {
          "type": "number",
          "default": 24,
          "minimum": 12,
          "maximum": 48,
          "description": "Font size for the speed reading display"
        },
        "speedreader.inlineCodeMaxLength": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Maximum character length for inline code to stay inline in the reading flow. Longer inline code is shown in the code panel instead."
        },
        "speedreader.autoPauseOnDiagram": {
          "type": "boolean",
          "default": false,
          "description": "Automatically pause playback when a diagram (e.g. mermaid) block is reached, so it can be viewed. Resume manually with play."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test:unit": "mocha",
    "test:integration": "npm run compile && vscode-test",
    "test": "npm run lint && npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/sinon": "^21.0.1",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "fs": "^0.0.1-security",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.0.0",
    "mocha": "^11.7.6",
    "sinon": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
